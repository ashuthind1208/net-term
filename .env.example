# Application
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=
# Leave blank when Vite proxies /api and /auth to the local API.
VITE_API_URL=
VITE_REQUIRE_AUTH=false

# PostgreSQL
DATABASE_URL=postgresql://postgres:replace-with-local-password@localhost:5432/net_term_solutions
DATABASE_SSL=false

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a Google OAuth authorized redirect URI.
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/callback
SESSION_SECRET=replace-with-a-long-random-value
ADMIN_EMAILS=admin@example.com

# Local development only
DEV_AUTH_BYPASS=false
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_USER_ROLE=admin

# SMTP email relay (Gmail example: smtp.gmail.com, port 465, secure true)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM_NAME=Net Term Solutions
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
# Optional address that receives a copy of every task event
EMAIL_AUDIT_TO=
